{
    "comments": {
        "lineComment": "--",
        "blockComment": [
            "{-",
            "-}"
        ]
    },
    "brackets": [
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "{",
            "}"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "{-",
            "close": "-}"
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string",
                "comment"
            ]
        }
    ],
    "surroundingPairs": [
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "{",
            "}"
        ],
        [
            "\"",
            "\""
        ]
    ],
    "folding": {
        "markers": {
            "start": "\\b(?:func|struct|trait|if|elif|else|while|for|match|invariant)\\b",
            "end": "\\bend\\b"
        }
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
    "indentationRules": {
        "increaseIndentPattern": "\\b(?:func|struct|trait|if|elif|else|while|for|match|invariant)\\b.*$",
        "decreaseIndentPattern": "^\\s*\\bend\\b"
    },
    "onEnterRules": [
        {
            "beforeText": "\\b(?:func|struct|trait|if|elif|else|while|for|match|invariant)\\b.*$",
            "action": {
                "indent": "indent"
            }
        },
        {
            "beforeText": "^\\s*case\\s+.*->\\s*$",
            "action": {
                "indent": "indent"
            }
        }
    ]
}