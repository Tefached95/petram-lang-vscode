{
  "name": "Petram",
  "scopeName": "source.petra",
  "fileTypes": [
    "petra"
  ],
  "patterns": [
    {
      "include": "#multiline_comment"
    },
    {
      "include": "#line_comment"
    },
    {
      "include": "#module_definition"
    },
    {
      "include": "#import_statement"
    },
    {
      "include": "#const_declaration"
    },
    {
      "include": "#function_definition"
    },
    {
      "include": "#method_definition"
    },
    {
      "include": "#associated_function_definition"
    },
    {
      "include": "#struct_definition"
    },
    {
      "include": "#trait_definition"
    },
    {
      "include": "#control_flow"
    },
    {
      "include": "#match_expression"
    },
    {
      "include": "#variable_declaration"
    },
    {
      "include": "#string_interpolation"
    },
    {
      "include": "#string"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "multiline_comment": {
      "name": "comment.block.petra",
      "begin": "\\{-",
      "end": "-\\}",
      "patterns": [
        {
          "include": "#multiline_comment"
        }
      ]
    },
    "line_comment": {
      "name": "comment.line.double-dash.petra",
      "match": "--.*$"
    },
    "module_definition": {
      "match": "\\b(module)\\s+([A-Z][A-Za-z0-9_]*(?:::[A-Z][A-Za-z0-9_]*)*)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.module.petra"
        },
        "2": {
          "name": "entity.name.namespace.petra"
        }
      }
    },
    "import_statement": {
      "match": "\\b(import)\\s+([A-Z][A-Za-z0-9_]*(?:::[A-Z][A-Za-z0-9_]*)*)(?:::\\{([^}]+)\\})?\\b",
      "captures": {
        "1": {
          "name": "keyword.control.import.petra"
        },
        "2": {
          "name": "entity.name.namespace.petra"
        },
        "3": {
          "name": "entity.name.type.petra"
        }
      }
    },
    "const_declaration": {
      "match": "\\b(const)\\s+(?:([A-Z][A-Za-z0-9_]*)(::))?([A-Z_][A-Z0-9_]*)\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];]+)\\s*(=)",
      "captures": {
        "1": {
          "name": "keyword.other.const.petra"
        },
        "2": {
          "name": "entity.name.type.petra"
        },
        "3": {
          "name": "punctuation.separator.double-colon.petra"
        },
        "4": {
          "name": "constant.other.petra"
        },
        "5": {
          "name": "punctuation.separator.colon.petra"
        },
        "6": {
          "name": "storage.type.petra"
        },
        "7": {
          "name": "keyword.operator.assignment.petra"
        }
      }
    },
    "function_definition": {
      "name": "meta.function.definition.petra",
      "begin": "\\b(func)\\s+([a-z_][a-zA-Z0-9_]*)\\s*\\(",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.func.petra"
        },
        "2": {
          "name": "entity.name.function.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "include": "#function_signature"
        },
        {
          "include": "#statements"
        }
      ]
    },
    "associated_function_definition": {
      "name": "meta.function.associated.petra",
      "begin": "\\b(func)\\s+([A-Z][A-Za-z0-9_]*)(::)([a-z_][a-zA-Z0-9_]*)(?:<([^>]+)>)?\\s*\\(",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.func.petra"
        },
        "2": {
          "name": "entity.name.type.petra"
        },
        "3": {
          "name": "punctuation.separator.double-colon.petra"
        },
        "4": {
          "name": "entity.name.function.petra"
        },
        "5": {
          "name": "entity.name.type.parameter.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "include": "#function_signature"
        },
        {
          "include": "#statements"
        }
      ]
    },
    "method_definition": {
      "name": "meta.method.definition.petra",
      "begin": "\\b(func)\\s*\\(([a-z_][a-zA-Z0-9_]*)\\s*:\\s*(\\*)?([A-Za-z0-9_<>,\\s]+)\\)\\s+([a-z_][a-zA-Z0-9_]*)\\s*\\(",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.func.petra"
        },
        "2": {
          "name": "variable.parameter.petra"
        },
        "3": {
          "name": "keyword.operator.pointer.petra"
        },
        "4": {
          "name": "storage.type.petra"
        },
        "5": {
          "name": "entity.name.function.method.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "include": "#function_signature"
        },
        {
          "include": "#statements"
        }
      ]
    },
    "function_signature": {
      "patterns": [
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];\\*]+)",
          "captures": {
            "1": {
              "name": "variable.parameter.petra"
            },
            "2": {
              "name": "punctuation.separator.colon.petra"
            },
            "3": {
              "name": "storage.type.petra"
            }
          }
        },
        {
          "match": "(\\))\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];\\*]+)",
          "captures": {
            "1": {
              "name": "punctuation.parenthesis.petra"
            },
            "2": {
              "name": "punctuation.separator.colon.petra"
            },
            "3": {
              "name": "storage.type.return.petra"
            }
          }
        }
      ]
    },
    "struct_definition": {
      "name": "meta.struct.definition.petra",
      "begin": "\\b(struct)\\s+([A-Z][A-Za-z0-9_]*)(?:<([^>]+)>)?(?:\\s*:\\s*([A-Za-z0-9_<>,\\s]+))?\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.struct.petra"
        },
        "2": {
          "name": "entity.name.type.struct.petra"
        },
        "3": {
          "name": "entity.name.type.parameter.petra"
        },
        "4": {
          "name": "entity.name.type.trait.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "include": "#invariant_block"
        },
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];\\*]+)",
          "captures": {
            "1": {
              "name": "variable.other.member.petra"
            },
            "2": {
              "name": "punctuation.separator.colon.petra"
            },
            "3": {
              "name": "storage.type.petra"
            }
          }
        },
        {
          "include": "#multiline_comment"
        },
        {
          "include": "#line_comment"
        }
      ]
    },
    "invariant_block": {
      "name": "meta.invariant.block.petra",
      "begin": "\\b(invariant)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.invariant.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "include": "#expressions"
        }
      ]
    },
    "trait_definition": {
      "name": "meta.trait.definition.petra",
      "begin": "\\b(trait)\\s+([A-Z][A-Za-z0-9_]*)(?:<([^>]+)>)?\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.trait.petra"
        },
        "2": {
          "name": "entity.name.type.trait.petra"
        },
        "3": {
          "name": "entity.name.type.parameter.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "match": "\\b(func)\\s*\\((self)\\s*:\\s*(Self)\\)\\s+([a-z_][a-zA-Z0-9_]*)\\s*\\(([^)]*)\\)\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];]+)",
          "captures": {
            "1": {
              "name": "keyword.other.func.petra"
            },
            "2": {
              "name": "variable.language.self.petra"
            },
            "3": {
              "name": "storage.type.self.petra"
            },
            "4": {
              "name": "entity.name.function.petra"
            },
            "5": {
              "name": "meta.parameters.petra"
            },
            "6": {
              "name": "punctuation.separator.colon.petra"
            },
            "7": {
              "name": "storage.type.petra"
            }
          }
        },
        {
          "include": "#multiline_comment"
        },
        {
          "include": "#line_comment"
        }
      ]
    },
    "control_flow": {
      "patterns": [
        {
          "begin": "\\b(if)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.if.petra"
            }
          },
          "end": "(?=\\b(?:elif|else|end)\\b)",
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        },
        {
          "begin": "\\b(elif)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.elif.petra"
            }
          },
          "end": "(?=\\b(?:elif|else|end)\\b)",
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        },
        {
          "begin": "\\b(else)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.else.petra"
            }
          },
          "end": "(?=\\bend\\b)",
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        },
        {
          "begin": "\\b(while)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.while.petra"
            }
          },
          "end": "\\b(end)\\b",
          "endCaptures": {
            "1": {
              "name": "keyword.control.end.petra"
            }
          },
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        },
        {
          "begin": "\\b(for)\\s+([a-z_][a-zA-Z0-9_]*)\\s+(in)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.for.petra"
            },
            "2": {
              "name": "variable.other.petra"
            },
            "3": {
              "name": "keyword.control.in.petra"
            }
          },
          "end": "\\b(end)\\b",
          "endCaptures": {
            "1": {
              "name": "keyword.control.end.petra"
            }
          },
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        },
        {
          "begin": "\\b(for)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(=)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.for.petra"
            },
            "2": {
              "name": "variable.other.petra"
            },
            "3": {
              "name": "keyword.operator.assignment.petra"
            }
          },
          "end": "\\b(end)\\b",
          "endCaptures": {
            "1": {
              "name": "keyword.control.end.petra"
            }
          },
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        }
      ]
    },
    "match_expression": {
      "begin": "\\b(match)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.match.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "match": "\\b(case)\\s+([A-Za-z0-9_:]+)(?:\\(([^)]*)\\))?\\s*(->)",
          "captures": {
            "1": {
              "name": "keyword.control.case.petra"
            },
            "2": {
              "name": "entity.name.type.variant.petra"
            },
            "3": {
              "name": "variable.other.petra"
            },
            "4": {
              "name": "keyword.operator.arrow.petra"
            }
          }
        },
        {
          "include": "#statements"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "include": "#line_comment"
        },
        {
          "include": "#multiline_comment"
        },
        {
          "include": "#variable_declaration"
        },
        {
          "include": "#control_flow"
        },
        {
          "include": "#match_expression"
        },
        {
          "include": "#return_statement"
        },
        {
          "include": "#defer_statement"
        },
        {
          "include": "#break_continue"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "variable_declaration": {
      "patterns": [
        {
          "match": "\\b(var)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];\\*]+)\\s*(=)",
          "captures": {
            "1": {
              "name": "keyword.other.var.petra"
            },
            "2": {
              "name": "variable.other.petra"
            },
            "3": {
              "name": "punctuation.separator.colon.petra"
            },
            "4": {
              "name": "storage.type.petra"
            },
            "5": {
              "name": "keyword.operator.assignment.petra"
            }
          }
        },
        {
          "match": "\\b(var)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "keyword.other.var.petra"
            },
            "2": {
              "name": "variable.other.petra"
            },
            "3": {
              "name": "keyword.operator.assignment.petra"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];]+)\\s*(=)",
          "captures": {
            "1": {
              "name": "keyword.other.const.petra"
            },
            "2": {
              "name": "constant.other.petra"
            },
            "3": {
              "name": "punctuation.separator.colon.petra"
            },
            "4": {
              "name": "storage.type.petra"
            },
            "5": {
              "name": "keyword.operator.assignment.petra"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "keyword.other.const.petra"
            },
            "2": {
              "name": "constant.other.petra"
            },
            "3": {
              "name": "keyword.operator.assignment.petra"
            }
          }
        }
      ]
    },
    "return_statement": {
      "match": "\\b(return)\\b",
      "name": "keyword.control.return.petra"
    },
    "defer_statement": {
      "match": "\\b(defer)\\b",
      "name": "keyword.control.defer.petra"
    },
    "break_continue": {
      "match": "\\b(break|continue)\\b",
      "name": "keyword.control.flow.petra"
    },
    "expressions": {
      "patterns": [
        {
          "include": "#string_interpolation"
        },
        {
          "include": "#string"
        },
        {
          "include": "#lambda"
        },
        {
          "include": "#function_call"
        },
        {
          "include": "#struct_instantiation"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "lambda": {
      "begin": "\\|",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.lambda.petra"
        }
      },
      "end": "\\b(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.end.petra"
        }
      },
      "patterns": [
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)\\s*([A-Za-z0-9_<>,\\s\\[\\];]+)",
          "captures": {
            "1": {
              "name": "variable.parameter.petra"
            },
            "2": {
              "name": "punctuation.separator.colon.petra"
            },
            "3": {
              "name": "storage.type.petra"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "function_call": {
      "begin": "([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(?:<([^>]+)>)?\\s*\\(",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.petra"
        },
        "2": {
          "name": "entity.name.type.parameter.petra"
        }
      },
      "end": "\\)",
      "patterns": [
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.name.petra"
            },
            "2": {
              "name": "punctuation.separator.colon.petra"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "struct_instantiation": {
      "begin": "([A-Z][A-Za-z0-9_]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.petra"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.other.member.petra"
            },
            "2": {
              "name": "punctuation.separator.colon.petra"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "variable": {
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b",
      "name": "variable.other.petra"
    },
    "string_interpolation": {
      "name": "string.quoted.double.interpolated.petra",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.petra",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.petra",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.begin.petra"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.end.petra"
            }
          },
          "patterns": [
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.petra",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.petra",
          "match": "\\\\."
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.float.petra",
          "match": "\\b([0-9][0-9_]*\\.[0-9_]+(?:[eE][+-]?[0-9_]+)?)\\b"
        },
        {
          "name": "constant.numeric.integer.petra",
          "match": "\\b([0-9][0-9_]*)\\b"
        },
        {
          "name": "constant.language.boolean.petra",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.petra",
          "match": "\\b(return|if|elif|else|match|case|while|for|in|end|break|continue|defer)\\b"
        },
        {
          "name": "keyword.other.petra",
          "match": "\\b(func|var|const|struct|trait|module|import|from|invariant)\\b"
        },
        {
          "name": "storage.type.self.petra",
          "match": "\\b(Self|self)\\b"
        },
        {
          "name": "storage.type.petra",
          "match": "\\b(Int|i8|i16|i32|i64|u8|u16|u32|u64|Float|f32|f64|Bool|String|Char|List|Result|Option)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.question.petra",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.exclamation.petra",
          "match": "!"
        },
        {
          "name": "keyword.operator.arithmetic.petra",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.petra",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.petra",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.assignment.petra",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.petra",
          "match": "->"
        },
        {
          "name": "keyword.operator.address-of.petra",
          "match": "&"
        },
        {
          "name": "keyword.operator.pointer.petra",
          "match": "\\*"
        },
        {
          "name": "keyword.operator.member-access.petra",
          "match": "\\."
        },
        {
          "name": "keyword.operator.range.petra",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.separator.double-colon.petra",
          "match": "::"
        }
      ]
    }
  }
}